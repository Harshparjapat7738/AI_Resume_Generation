{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cover letter content output",
  "type": "object",
  "additionalProperties": false,
  "required": ["greeting", "openingParagraph", "bodyParagraphs", "closingParagraph", "signOff"],
  "$defs": {
    "evidenceId": {
      "type": "string",
      "pattern": "^(EXP|PROJ|SKILL|CERT|EDU|ACH)-[0-9]{3,4}$"
    },
    "groundedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "evidenceIds"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 1200 },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "$ref": "#/$defs/evidenceId" }
        }
      }
    }
  },
  "properties": {
    "greeting": { "type": "string", "minLength": 1, "maxLength": 200 },
    "openingParagraph": { "$ref": "#/$defs/groundedText" },
    "bodyParagraphs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/groundedText" }
    },
    "closingParagraph": { "$ref": "#/$defs/groundedText" },
    "signOff": { "type": "string", "minLength": 1, "maxLength": 100 }
  }
}
