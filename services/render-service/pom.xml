<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ai.careerforge</groupId>
        <artifactId>careerforge-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>render-service</artifactId>
    <name>render-service</name>
    <description>Renders an already-grounded, schema-validated document model into a PDF (ADR-036). No AI call of any kind.</description>

    <dependencies>
        <dependency>
            <groupId>ai.careerforge</groupId>
            <artifactId>platform-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-config</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
        <!-- Structural well-formedness check for loaded template markup (this step) and,
             per ADR-036, the strict-XHTML normalisation pass ahead of Open HTML to PDF
             (a later step) — the same library ADR-036 already names for that second use.
             Version is managed in the root pom. -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
        </dependency>
        <!-- The HTML-fill half of ADR-036's Thymeleaf -> strict-XHTML -> Open HTML to PDF
             pipeline. Version managed by spring-boot-starter-parent, like every other
             spring-boot-starter-* dependency in this reactor — no explicit version pinned
             here, matching every peer service's own starters. This service never uses
             Thymeleaf's Spring MVC view-resolution machinery (ThymeleafHtmlRenderer builds
             its own TemplateEngine over a StringTemplateResolver, fed by TemplateProvider) —
             only the templating engine itself. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <!-- The PDF half of ADR-036's Thymeleaf -> strict-XHTML -> Open HTML to PDF pipeline —
             the platform's approved PDF engine (see ARCHITECTURE_DECISIONS.md ADR-036's Reason
             section for why: JVM-native, permissively licensed, no second runtime class like a
             Chromium-based alternative would add). Versions managed in the root pom. -->
        <dependency>
            <groupId>io.github.openhtmltopdf</groupId>
            <artifactId>openhtmltopdf-pdfbox</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
