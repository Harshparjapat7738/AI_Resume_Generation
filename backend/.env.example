# =============================================================================
# CareerForge AI — environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Variable purpose and setup instructions: docs/EXTERNAL_APIS.md
# =============================================================================

# ----- Application -------------------------------------------------------
APP_ENV=local
SPRING_PROFILES_ACTIVE=local

# ----- MongoDB Atlas (primary database) ----------------------------------
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# One cluster, one logical database per service (see docs/DATABASE.md).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_AUTH=careerforge_auth
MONGODB_DB_PROFILE=careerforge_profile
MONGODB_DB_JD=careerforge_jd 
MONGODB_DB_ASSESSMENT=careerforge_assessment
# careerforge_document is not in blueprint §7 — added by ADR-002 for rendered-artifact metadata
MONGODB_DB_APPLICATION=careerforge_application

# ----- Redis (cache, rate limiting, job streams) -------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ----- Service discovery / config ----------------------------------------
CONFIG_SERVER_URI=http://config-server:8888
EUREKA_SERVER_URI=http://discovery-server:8761/eureka/

# ----- JWT ---------------------------------------------------------------
# JWT_SECRET must be >= 32 bytes. Generate: openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=careerforge-ai
JWT_ACCESS_EXPIRATION=900
JWT_REFRESH_EXPIRATION=1209600
# false for local/dev (plain HTTP). Set true in docker/production, where the gateway and
# frontend are served over HTTPS — auth-service only.
REFRESH_COOKIE_SECURE=false

# ----- Google OAuth 2.0 (auth-service only) ------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/oauth2/callback/google
# Where the browser lands after a successful Google sign-in callback.
FRONTEND_BASE_URL=http://localhost:5173

# ----- Groq (ai-service only) — mandatory; ai-service will not start without this ------------
# The primary AI provider: JD Analysis, Evidence Selection, JD Optimization, Email Content
# (ADR-033 removed resume/cover-letter generation entirely; ADR-039 reintroduced Gemini,
# below, as a fallback for JD Analysis/Optimization only — Groq is still primary everywhere).
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=60
GROQ_MAX_OUTPUT_TOKENS=4096

# ----- Gemini (ai-service only) — optional; fallback provider (ADR-039) ----------------------
# Used only when Groq fails a fallback-eligible way (rate limit, timeout, 5xx) for JD Analysis
# or JD-Optimization adjudication — never called when Groq succeeds, never for any other
# operation. Leave GEMINI_API_KEY unset (or GEMINI_ENABLED=false) to disable fallback entirely;
# ai-service still starts and Groq-only behaviour is unchanged.
GEMINI_ENABLED=true
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_OUTPUT_TOKENS=1200
AI_FALLBACK_OPERATIONS=jd-analysis,jd-optimization

# ----- MinIO / S3 (profile-service only) — "My Templates" file storage (ADR-034) -------------
# A private bucket for user-uploaded Resume/Cover Letter template files. Never publicly
# readable (see docker-compose.yml's minio-init service, which locks it down once at startup)
# — every download goes through profile-service's own ownership-checked endpoint.
# S3_ACCESS_KEY/S3_SECRET_KEY authenticate against MinIO's own root account — set them to the
# same values as MINIO_ROOT_USER/MINIO_ROOT_PASSWORD below (MinIO's root user is itself a valid
# S3-compatible access key; no separate IAM user is provisioned for local/dev).
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=careerforge-templates
S3_PATH_STYLE_ACCESS=true

# ----- Gmail API (application-service, optional) -------------------------
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8080/api/applications/gmail/callback

# ----- Frontend ----------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080

# ----- Observability ------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
